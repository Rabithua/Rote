  {
    "name": "gift_import_codes",
    "description": "Import Apple offer codes into a gift campaign; the campaign is created on first import. Codes must not be expired. Super admin only.",
    "requiredScopes": [],
    "requiredRole": "super_admin",
    "inputSchema": {
      "type": "object",
      "properties": {
        "campaignName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Sheet headline shown to recipients. Omit to use the client default."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Sheet body text shown to recipients (also records who the campaign targets and why)."
        },
        "codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 255
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "code",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "campaignName",
        "codes"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "gift_allocate",
    "description": "Allocate one gift code per recipient from a campaign pool. The recipient list is explicit (usernames or userids); eligibility targeting is decided by the caller, not this tool. Already-allocated recipients are skipped; fails when too few unexpired codes remain. Super admin only.",
    "requiredScopes": [],
    "requiredRole": "super_admin",
    "inputSchema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "format": "uuid"
        },
        "usernames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "userids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 5000
        }
      },
      "required": [
        "campaignId"
      ],
      "oneOf": [
        {
          "required": [
            "usernames"
          ]
        },
        {
          "required": [
            "userids"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "gift_status",
    "description": "Gift campaign funnel: total/shown plus live available and allocated-active counts, one expired bucket (covers expired-unallocated and expired-unshown), and recipients whose codes expire within 7 days while unshown. Super admin only.",
    "requiredScopes": [],
    "requiredRole": "super_admin",
    "inputSchema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "campaignId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "gift_detail",
    "description": "Per-code gift campaign detail: recipient, username, status, expiry, allocation and shown timestamps. Returns at most 10,000 rows; truncated=true means the campaign holds more (check gift_status totals instead). Super admin only.",
    "requiredScopes": [],
    "requiredRole": "super_admin",
    "inputSchema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "campaignId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "gift_grant",
    "description": "Grant one additional gift code from a campaign pool to a single user (by username or userid), even if they already hold one. Super admin only.",
    "requiredScopes": [],
    "requiredRole": "super_admin",
    "inputSchema": {
      "type": "object",
