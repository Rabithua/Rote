# Rote Server Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Required)
# PostgreSQL connection URL
POSTGRESQL_URL=postgresql://rote:your_password@localhost:5432/rote

# CORS Configuration (Optional)
# Comma-separated list of allowed origins
# If not set, all origins are allowed
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Rote Pro billing is disabled by default. Self-hosted deployments do not need
# any of the remaining BILLING_* values.
BILLING_ENABLED=false
# Keep purchases closed while grant reconciliation and resource observation run.
# BILLING_PURCHASE_AVAILABLE=false
# Official storage starts in observe; change to enforce only after baseline acceptance.
# RESOURCE_OFFICIAL_STORAGE_ENFORCEMENT=observe
# RESOURCE_UPLOAD_PROXY_ORIGIN=https://api.rote.ink
# BILLING_INSTANCE_ID=rote-official
# BILLING_OFFICIAL_ORIGIN=https://api.rote.ink
# BILLING_PAID_SERVER_URL=https://billing.rote.ink
# BILLING_PRODUCT_IDS=ink.rote.pro.monthly,ink.rote.pro.yearly
# BILLING_PAID_CONNECT_TIMEOUT_MS=3000
# BILLING_PAID_TOTAL_TIMEOUT_MS=10000
# BILLING_ROTE_TO_PAID_ACTIVE_KEY_ID=
# BILLING_ROTE_TO_PAID_ACTIVE_SECRET=
# BILLING_ROTE_TO_PAID_PREVIOUS_KEY_ID=
# BILLING_ROTE_TO_PAID_PREVIOUS_SECRET=
# BILLING_PAID_TO_ROTE_ACTIVE_KEY_ID=
# BILLING_PAID_TO_ROTE_ACTIVE_SECRET=
# BILLING_PAID_TO_ROTE_PREVIOUS_KEY_ID=
# BILLING_PAID_TO_ROTE_PREVIOUS_SECRET=
