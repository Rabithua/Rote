# Rote Backend Environment Variables Template
# 复制此文件为 .env 并填入实际配置值

# ==========================================
# 基础服务配置
# ==========================================

# 服务端口 (默认: 3000)
PORT=3000

# ==========================================
# 数据库配置
# ==========================================

# PostgreSQL 数据库连接字符串
POSTGRESQL_URL=postgresql://rote:rote_password_123@localhost:5433/rote

# ==========================================
# Rote Pro Billing（默认关闭）
# ==========================================

# 自托管实例保持 false 时不需要任何其他 BILLING_* 配置
BILLING_ENABLED=false
